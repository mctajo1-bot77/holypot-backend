generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  walletAddress String?
  password      String? // hashed bcrypt
  nickname      String?  @unique // unico
  emailVerified Boolean @default(false)
  country            String?
  verificationToken  String?  @unique     // ← NUEVO
  tokenExpiry        DateTime?             // ← NUEVO
  entries       Entry[]
  advices       Advice[]
  payouts       Payout[]
}

model Competition {
  id           String   @id @default(uuid())
  type         String // "daily" (futuro: weekly, monthly, six_months)
  level        String // "basic", "medium", "premium"
  startAt      DateTime
  endAt        DateTime
  status       String   @default("active") // active, pending_approval, closed, cancelled
  prizePool    Float    @default(0.0)
  participants Int      @default(0)
  entries      Entry[]
}

model Entry {
  id             String   @id @default(uuid())
  userId         String
  competitionId  String?
  level          String
  paymentId      String? // ID del pago en NOWPayments
  paymentNetwork String?  @default("polygon") // polygon, trc20, ethereum
  status         String   @default("pending") // pending, confirmed, disqualified, winner, closed
  virtualCapital Float // capital inicial + P&L acumulado
  createdAt      DateTime @default(now())
  closedAt       DateTime? // fecha de cierre de la competencia (seteado por cron)
  wasRollover    Boolean  @default(false) // true si esta entrada fue una renovación por rollover

  user        User         @relation(fields: [userId], references: [id])
  competition Competition? @relation(fields: [competitionId], references: [id])
  positions   Position[] // trades
  payouts     Payout[]   // premios ganados en esta entrada
}

model Advice {
  id     Int      @id @default(autoincrement())
  userId String
  user   User     @relation(fields: [userId], references: [id])
  date   DateTime @default(now())
  text   String

  @@index([userId])
}

model Position {
  id          String    @id @default(uuid())
  entry       Entry     @relation(fields: [entryId], references: [id])
  entryId     String
  symbol      String
  direction   String
  lotSize     Float?
  entryPrice  Float
  orderType   String    @default("market")  // market, limit, stop
  targetPrice Float?                         // precio objetivo para órdenes limit/stop
  orderStatus String    @default("filled")  // filled, pending, cancelled
  takeProfit  Float? // opcional
  stopLoss    Float? // opcional
  closeReason String? // "manual", "TP_hit", "SL_hit"
  currentPnl  Float?
  openedAt    DateTime  @default(now())
  closedAt    DateTime?
}

model Payout {
  id            Int          @id @default(autoincrement())
  userId        String
  entryId       String?      // link a Entry para trazabilidad correcta
  level         String
  position      Int
  amount        Float
  date          DateTime     @default(now())
  status        String       @default("pending") // pending, sent, confirmed, failed
  paymentId     String?                           // NowPayments payout ID
  network       String?      @default("trc20")    // polygon, trc20, ethereum
  walletAddress String?                            // cached wallet for batch
  batchId       Int?

  user          User         @relation(fields: [userId], references: [id])
  entry         Entry?       @relation(fields: [entryId], references: [id])
  batch         PayoutBatch? @relation(fields: [batchId], references: [id])
}

model PayoutBatch {
  id            Int       @id @default(autoincrement())
  network       String                              // polygon, trc20, ethereum
  status        String    @default("pending")       // pending, sent, confirmed, failed
  totalAmount   Float
  payoutCount   Int       @default(0)
  nowpaymentsId String?                             // batch payout ID from NOWPayments
  sentAt        DateTime?
  confirmedAt   DateTime?
  createdAt     DateTime  @default(now())

  payouts       Payout[]
}
model DailyCandle {
  id        Int      @id @default(autoincrement())
  symbol    String
  date      DateTime // fecha del día (00:00 UTC)
  time      Int      // unix seconds
  open      Float
  high      Float
  low       Float
  close     Float

  @@unique([symbol, date, time]) // evita duplicados
  @@index([symbol, date])
}
